{
  "manifest_version": 3,
  "name": "Radar Trades",
  "short_name": "Radar Trades",
  "version": "42.1",
  "description": "Scanner de setups crypto sur Binance Futures : statuts, plans, tailles, heatmaps, tendance et cycle. Sans clé API, sans ordre.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Ouvrir Radar Trades", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["notifications", "storage"],
  "host_permissions": [
    "https://fapi.binance.com/*", "https://api.binance.com/*", "https://api.coingecko.com/*", "https://api.llama.fi/*",
    "https://yields.llama.fi/*", "https://www.okx.com/*", "https://api.mexc.com/*", "https://api.alternative.me/*",
    "https://cryptoast.fr/*", "https://journalducoin.com/*", "https://www.cointribune.com/*", "https://cointelegraph.com/*", "https://www.coindesk.com/*"
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
